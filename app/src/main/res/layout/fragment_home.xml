<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Welcome Section -->
        <TextView
            android:id="@+id/tvGreeting"
            style="@style/Typography.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="Hello, Student 👋"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toStartOf="@id/ivNotifications"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hello, Tenzin 👋" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Typography.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Welcome back to Student Club Connect"
            app:layout_constraintEnd_toEndOf="@id/tvGreeting"
            app:layout_constraintStart_toStartOf="@id/tvGreeting"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

        <ImageView
            android:id="@+id/ivNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_navy" />

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/input_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search clubs and events"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Featured Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeatured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/primary_navy"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/searchCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMegaphone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="#22FFFFFF"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@drawable/ic_announcement"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvFeaturedLabel"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="CAMPUS UPDATES"
                    android:textColor="#CCFFFFFF"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/cardMegaphone"
                    app:layout_constraintTop_toTopOf="@id/cardMegaphone" />

                <TextView
                    android:id="@+id/tvFeaturedTitle"
                    style="@style/Typography.SubHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Annual Student Club Showcase starts this week!"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toStartOf="@id/ivFeaturedArrow"
                    app:layout_constraintStart_toStartOf="@id/tvFeaturedLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvFeaturedLabel" />

                <ImageView
                    android:id="@+id/ivFeaturedArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Popular Clubs Section -->
        <TextView
            android:id="@+id/tvPopularClubsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:text="Popular Clubs"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFeatured" />

        <TextView
            android:id="@+id/btnExploreClubs"
            style="@style/Component.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Explore All"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvPopularClubsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvPopularClubsLabel" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerPopularClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvPopularClubsLabel"
            app:shimmer_auto_start="true">
            <include layout="@layout/shimmer_item_club" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPopularClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvPopularClubsLabel"
            tools:listitem="@layout/item_club" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/popularClubsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvPopularClubs,shimmerPopularClubs" />

        <!-- Upcoming Events Section -->
        <TextView
            android:id="@+id/tvUpcomingEventsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:text="Upcoming Events"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/popularClubsBarrier" />

        <TextView
            android:id="@+id/btnViewAllEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_view_all"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="View All"
            android:textColor="@color/primary_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvUpcomingEventsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUpcomingEventsLabel" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerUpcomingEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingEventsLabel"
            app:shimmer_auto_start="true">
            <include layout="@layout/shimmer_item_event" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingEventsLabel"
            tools:listitem="@layout/item_event" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoEvents"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingEventsLabel">

            <TextView
                android:id="@+id/tvNoEvents"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="No upcoming events" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/upcomingEventsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvUpcomingEvents,cardNoEvents,shimmerUpcomingEvents" />

        <!-- Announcements Section -->
        <TextView
            android:id="@+id/tvAnnouncementsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:text="Recent Announcements"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/upcomingEventsBarrier" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel"
            app:shimmer_auto_start="true">
            <include layout="@layout/shimmer_item_announcement" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel"
            tools:listitem="@layout/item_announcement" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoAnnouncements"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel">

            <TextView
                android:id="@+id/tvNoAnnouncements"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="No recent announcements" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/announcementsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvRecentAnnouncements,cardNoAnnouncements,shimmerAnnouncements" />

        <!-- My Clubs Section -->
        <TextView
            android:id="@+id/tvMyClubsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:text="My Clubs"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/announcementsBarrier" />

        <TextView
            android:id="@+id/btnViewAllClubs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_view_all"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="View All"
            android:textColor="@color/primary_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvMyClubsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvMyClubsLabel" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerMyClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvMyClubsLabel"
            app:shimmer_auto_start="true">
            <include layout="@layout/shimmer_item_club" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMyClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvMyClubsLabel"
            tools:listitem="@layout/item_club" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoClubs"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvMyClubsLabel">

            <TextView
                android:id="@+id/tvNoClubs"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="You haven't joined any clubs yet." />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
