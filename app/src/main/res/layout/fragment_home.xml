<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="80dp">

        <!-- Welcome Section -->
        <TextView
            android:id="@+id/tvGreeting"
            style="@style/Typography.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="Hello, Student 👋"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toStartOf="@id/ivNotifications"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hello, Tenzin 👋" />

        <ImageView
            android:id="@+id/ivNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_notifications"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_navy" />

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/input_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Search clubs and events"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/searchCard"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/shimmer_item_club" />
                <include layout="@layout/shimmer_item_event" />
                <include layout="@layout/shimmer_item_club" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Popular Clubs Section -->
        <TextView
            android:id="@+id/tvPopularClubsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Popular Clubs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchCard" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPopularClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvPopularClubsLabel"
            tools:listitem="@layout/item_club" />

        <!-- Upcoming Events Section -->
        <TextView
            android:id="@+id/tvUpcomingEventsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Upcoming Events"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvPopularClubs" />

        <TextView
            android:id="@+id/btnViewAllEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_view_all"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="View All"
            android:textColor="@color/primary_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvUpcomingEventsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUpcomingEventsLabel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingEventsLabel"
            tools:listitem="@layout/item_event" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoEvents"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingEventsLabel">

            <TextView
                android:id="@+id/tvNoEvents"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="No upcoming events" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/eventsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvUpcomingEvents,cardNoEvents" />

        <!-- Announcements Section -->
        <TextView
            android:id="@+id/tvAnnouncementsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Recent Announcements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eventsBarrier" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel"
            tools:listitem="@layout/item_announcement" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoAnnouncements"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvAnnouncementsLabel">

            <TextView
                android:id="@+id/tvNoAnnouncements"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="No recent announcements" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/announcementsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvRecentAnnouncements,cardNoAnnouncements" />

        <!-- My Clubs Section -->
        <TextView
            android:id="@+id/tvMyClubsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="My Clubs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/announcementsBarrier" />

        <TextView
            android:id="@+id/btnViewAllClubs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_view_all"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="View All"
            android:textColor="@color/primary_navy"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvMyClubsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvMyClubsLabel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMyClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layout_constraintTop_toBottomOf="@id/tvMyClubsLabel"
            tools:listitem="@layout/item_club" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoClubs"
            style="@style/Component.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvMyClubsLabel">

            <TextView
                android:id="@+id/tvNoClubs"
                style="@style/Typography.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:text="You haven't joined any clubs yet." />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
