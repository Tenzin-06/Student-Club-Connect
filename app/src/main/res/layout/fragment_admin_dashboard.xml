<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Admin Dashboard"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Typography.SubHeading" />

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/Typography.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome, Admin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <TextView
            android:id="@+id/tvManagementLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Quick Management"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stats_card"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvManagementLabel">

            <!-- Clubs -->
            <LinearLayout
                android:id="@+id/btnManageClubs"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_clubs" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clubs" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage all student clubs"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Events -->
            <LinearLayout
                android:id="@+id/btnManageEvents"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_events" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage all campus events"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Announcements -->
            <LinearLayout
                android:id="@+id/btnManageAnnouncements"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_announcement" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Announcements" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcast news to everyone"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Users -->
            <LinearLayout
                android:id="@+id/btnManageUsers"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_profile" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Users" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View and manage user roles"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>