<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Admin Dashboard"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Typography.SubHeading" />

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/Typography.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome, Admin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Quick Stats Grid -->
        <GridLayout
            android:id="@+id/gridStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome">

            <!-- Students -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatStudents"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="342" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Students" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Clubs -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatClubs"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="18" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clubs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Presidents -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatPresidents"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="18" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Presidents" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Events -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatEvents"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="47" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Memberships -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatMemberships"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="728" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memberships" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Announcements -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvStatAnnouncements"
                        style="@style/Typography.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_navy"
                        tools:text="124" />
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Announcements" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- Analytics Section: Club Memberships -->
        <TextView
            android:id="@+id/tvAnalyticsClubsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Club Memberships"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gridStats" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnalyticsClubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvAnalyticsClubsLabel">

            <LinearLayout
                android:id="@+id/containerClubAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <!-- Bar rows will be added programmatically -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Analytics Section: Events by Month -->
        <TextView
            android:id="@+id/tvAnalyticsEventsLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Events (Last 6 Months)"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAnalyticsClubs" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnalyticsEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvAnalyticsEventsLabel">

            <LinearLayout
                android:id="@+id/containerEventAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <!-- Bar rows will be added programmatically -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvManagementLabel"
            style="@style/Typography.SubHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Quick Management"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAnalyticsEvents" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stats_card"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvManagementLabel"
            android:paddingBottom="60dp">

            <!-- Clubs -->
            <LinearLayout
                android:id="@+id/btnManageClubs"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_clubs" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clubs" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage all student clubs"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Events -->
            <LinearLayout
                android:id="@+id/btnManageEvents"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_events" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage all campus events"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Announcements -->
            <LinearLayout
                android:id="@+id/btnManageAnnouncements"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_announcement" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Announcements" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcast news to everyone"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

            <!-- Users -->
            <LinearLayout
                android:id="@+id/btnManageUsers"
                style="@style/ProfileListItem">
                <ImageView style="@style/ProfileInfoIcon" android:src="@drawable/ic_profile" app:tint="@color/primary_navy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Typography.SubHeading.Normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Users" />
                    <TextView
                        style="@style/Typography.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View and manage user roles"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>